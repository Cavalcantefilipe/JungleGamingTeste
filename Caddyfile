{
	admin off
	auto_https off
	persist_config off
}

(static_files) {
	file_server {
		precompressed br gzip
	}
}

(security_headers) {
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://realtime.kurio.app; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
	}
}

:{$PORT:3000} {
	root * {$SITE_ROOT:dist}
	encode gzip
	import security_headers

	handle /healthz {
		header Cache-Control no-store
		respond "ok" 200
	}

	@mockApi path /api /api/* /socket.io /socket.io/*
	handle @mockApi {
		header Cache-Control no-store
		respond 404
	}

	handle /mockServiceWorker.js {
		header Cache-Control "no-cache, no-store, must-revalidate"
		header Service-Worker-Allowed /
		import static_files
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		import static_files
	}

	@publicFile path_regexp \.[^/]+$
	handle @publicFile {
		header Cache-Control no-cache
		import static_files
	}

	handle {
		header Cache-Control no-cache
		try_files {path} /index.html
		import static_files
	}

	handle_errors {
		import security_headers
		header Cache-Control no-store
		respond "{err.status_code}" {err.status_code}
	}
}
